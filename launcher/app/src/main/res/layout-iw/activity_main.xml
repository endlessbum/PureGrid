<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-only header positioning. Other languages use layout/activity_main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden).
         Keep in step with layout/activity_main.xml: every view there must exist here too. -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="68dp"
        android:layout_gravity="right"
        android:gravity="right"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 300"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@+id/topButtons"
                android:layout_marginStart="16dp"
                android:orientation="horizontal"
                android:gravity="right|bottom">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="9dp"
                    android:orientation="vertical">

                    <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#E6FFFFFF"
                        android:textSize="17sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.02"
                        android:includeFontPadding="false"
                        android:visibility="gone" />

                    <!-- The weekday on its own line, with the day and the month under it. -->
                    <TextView
                        android:id="@+id/weekday"
                        android:gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />

                    <!-- A plain TextView, not a TextClock: the date is set in code so it can be shrunk
                         to fit the room the top bar leaves (TextClock re-measures itself and ignores
                         autoSize, which cuts a long localized date off with an ellipsis). -->
                    <TextView
                        android:id="@+id/date"
                        android:gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="19dp"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/greeting"
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.22"
                        android:textAllCaps="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <!-- The clock slot is a one-way carousel, as in layout/activity_main.xml:
                             the clock face and the weather face take turns sliding through it,
                             always travelling left to right. slideClockSlot() treats the slot's
                             parent as this row, so the slot stays a direct child of it. -->
                        <FrameLayout
                            android:id="@+id/clockSlot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:id="@+id/clockFace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextClock
                                    android:id="@+id/clock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="h:mm"
                                    android:format24Hour="HH:mm"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="52sp"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 300"
                                    android:letterSpacing="-0.04"
                                    android:includeFontPadding="false" />

                                <TextClock
                                    android:id="@+id/ampm"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginBottom="8dp"
                                    android:format12Hour="a"
                                    android:format24Hour=""
                                    android:textColor="#B3FFFFFF"
                                    android:textSize="15sp"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 500"
                                    android:letterSpacing="0.08"
                                    android:textAllCaps="true" />
                            </LinearLayout>

                            <!-- The weather slide, mirroring the base layout: the temperature in
                                 the clock's own type and size, so the swap is like for like.
                                 Without a connection the crossed cloud takes the temp's place. -->
                            <FrameLayout
                                android:id="@+id/weatherFace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start|center_vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/weatherTemp"
                                    android:gravity="left"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:singleLine="true"
                                    android:textColor="#FFFFFFFF"
                                    android:textSize="52sp"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 300"
                                    android:letterSpacing="-0.04"
                                    android:includeFontPadding="false" />

                                <ImageView
                                    android:id="@+id/weatherIcon"
                                    android:layout_width="46dp"
                                    android:layout_height="46dp"
                                    android:layout_gravity="start|center_vertical"
                                    android:src="@drawable/ic_weather_off"
                                    android:contentDescription="@string/weather_offline"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.gathin.tvhome.AccountAvatarView
                    android:id="@+id/btnAccount"
                    style="@style/TopIconButton"
                    android:contentDescription="@string/account"
                    android:nextFocusDown="@+id/grid" />

                <ImageView
                    android:id="@+id/btnSettings"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="@string/settings"
                    android:nextFocusDown="@+id/grid" />

                <ImageView
                    android:id="@+id/btnSearch"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search"
                    android:nextFocusDown="@+id/grid" />

                <ImageView
                    android:id="@+id/btnClear"
                    style="@style/TopIconButton"
                    android:src="@drawable/ic_clear"
                    android:contentDescription="@string/clear"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="200dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/input"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
