<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (the keys are
  the ones commented in this file) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>ru.rt.video.app.tv</item>
        <item>ru.kinopoisk.tv</item>
        <item>com.vk.tv</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.setupwizard</item>
        <item>com.smartdevice.leanbacklauncher.customizer</item>
        <item>com.smartdevice.dailyshortcut</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit.
         Android 11+ note: the manifest <queries> only declares leanback launchers, so the action
         fallback resolves on those versions only while the package exposes some entry the queries
         cover. If a firmware's Live TV app has neither, add its package to the manifest <queries>. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>

    <!-- Remote buttons that open Settings, by Linux scancode (HOME_KEY_SERVICE=1 build-and-install.sh). Remotes
         that send KEYCODE_SETTINGS need no entry. Some send a code Android does not map: the Xiaomi/Fengmi
         projector remote's gear button is scancode 384 (KEY_TAPE). Find yours with
         `tools/tv.py 'getevent -lt'` while pressing the button. Leave empty to omit. -->
    <integer-array name="settings_key_scancodes">
        <!-- This TV's BLE remote FAV button: getevent shows EV_KEY 01a0 = 416 (KEY_VIDEOPHONE);
             Android maps it to nothing, so the FAV press would otherwise be dropped. -->
        <item>416</item>
        <!-- This TV's <new> button: getevent shows EV_KEY 00f0 = 240 (KEY_UNKNOWN). -->
        <item>240</item>
    </integer-array>
    <integer-array name="settings_key_keycodes">
    </integer-array>

    <!-- Remote buttons that toggle the VPN (same as the network pill). -->
    <integer-array name="vpn_key_scancodes">
        <!-- This TV's "Network" button: getevent shows EV_KEY 01b7 = 439. -->
        <item>439</item>
    </integer-array>
    <integer-array name="vpn_key_keycodes">
    </integer-array>

    <!-- Remote buttons that open the Inputs (Вход) dropdown under the top-right pill. Same scancode rule
         as above; empty leaves the behaviour untouched. -->
    <integer-array name="inputs_key_scancodes">
        <!-- This TV's BLE remote CD/Media button: getevent shows EV_KEY 017f = 383 (KEY_CD);
             Android maps it to nothing, so the press would otherwise be dropped. -->
        <item>383</item>
    </integer-array>
    <integer-array name="inputs_key_keycodes">
    </integer-array>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The green (or amber, when traffic is blocked)
         VPN badge shows for any VPN either way; with an app set here and installed, a white "VPN off"
         badge also shows while no VPN is up. With the app not installed, no VPN badge is drawn. -->
    <string name="vpn_app" translatable="false">com.v2raytun.android</string>

    <!-- Broadcast that switches the VPN app on or off in the background, so that pressing the network
         pill toggles the VPN without opening the app. The app itself decides the direction from its own
         state, and the broadcast is sent to the component that declared it, so the app stays in the
         background. v2RayTun answers the same broadcast as its home-screen widget:
         com.v2raytun.android.action.widget.click. Empty: the pill opens the VPN app instead. -->
    <string name="vpn_toggle_action" translatable="false">com.v2raytun.android.action.widget.click</string>
    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>

    <!-- Basic motion is on; advanced effects are opt-in in the launcher's own Settings screen. -->
    <bool name="animations">true</bool>
    <bool name="advanced_effects">false</bool>

    <!-- Optional Default-home tile; keep this key for existing themes and tile-ordering work.
         Off by default because the chooser is also available from launcher settings. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Module cards: an app that declares a card (docs/specs/card.md) can stand in for its tile with its own
         label, caption and glow colour, once you answer Show on the prompt. false: never look for cards or ask.
         Off by default: the owner opted out of the feature and its settings menu row. -->
    <bool name="module_cards">false</bool>

    <!-- Reduced motion: for TVs whose GPU cannot keep up (MediaTek MT5895 on Android 10 is the known case).
         true keeps the GPU drawing path but calms the movement: a stiff highlight spring with no bounce,
         tiles that zoom without overshoot, shorter fades and no tile entrance when Home comes back. Set it
         here or with "reduced_motion": true in a theme's config.json; false keeps the normal motion. -->
    <bool name="reduced_motion">false</bool>

    <!-- Time-of-day backdrop behind everything: a dark gradient that follows the clock, with a warm
         horizon glow around sunrise and sunset. 0 keeps the plain background (the default); 1 to 100
         sets its opacity. Around 60 reads clearly without hiding a wallpaper. Can also be set with
         "sky_intensity": 60 in a theme's config.json. -->
    <integer name="sky_intensity">0</integer>

    <!-- Content search (the poster strips under the app search): how many suggestion rows each
         installed search-provider app (YouTube, Kinopoisk, …) is asked for per query, and how long
         one app may take to answer before its strip is skipped for that query. Slow TVs can raise
         both in a theme's config.json: "search_provider_limit": 12, "search_provider_timeout_ms": 4000. -->
    <integer name="search_provider_limit">8</integer>
    <integer name="search_provider_timeout_ms">2500</integer>
</resources>
