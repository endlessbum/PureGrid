<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FF000000">

    <!-- The home screen's ambient glow, tinted with the accent chosen below. -->
    <View
        android:id="@+id/settingsGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fadingEdge="none"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingTop="40dp"
            android:paddingBottom="56dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/headerBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="28dp"
                    android:layout_toStartOf="@id/doneButton"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_kicker"
                        android:textAllCaps="true"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.22" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/launcher_settings"
                        android:textColor="#FFFFFFFF"
                        android:textSize="42sp"
                        android:fontFamily="@font/outfit_light"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_subtitle"
                        android:textColor="#99FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_regular"
                        android:letterSpacing="0.02" />
                </LinearLayout>

                <TextView
                    android:id="@+id/doneButton"
                    style="@style/TopButton"
                    android:layout_alignParentEnd="true"
                    android:layout_alignBottom="@id/headerBlock"
                    android:text="@string/done" />
            </RelativeLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/accent_section" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/accent_hint" />

            <LinearLayout
                android:id="@+id/accentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="6dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/accentSummary"
                style="@style/SettingsHint"
                android:layout_marginTop="14dp"
                android:textColor="#ACB8C1" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_layout" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="4dp"
                android:text="@string/columns_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_motion" />

            <TextView
                android:id="@+id/animationsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/greetingChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/weatherChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_top_bar" />

            <TextView
                android:id="@+id/clearButtonChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/searchButtonChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/accountButtonChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/section_theme_system" />

            <TextView
                android:id="@+id/followThemeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="4dp"
                android:text="@string/follow_theme" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/follow_theme_hint" />

            <TextView
                android:id="@+id/defaultHomeChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="18dp"
                android:text="@string/home_settings" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/home_settings_help" />

            <TextView
                android:id="@+id/tvSettingsChoice"
                style="@style/SettingsRow"
                android:layout_marginTop="18dp"
                android:text="@string/tv_settings" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
